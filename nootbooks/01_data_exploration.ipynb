# 🧪 Step 1: Import tools
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns

# 🧪 Step 2: Load dataset
df = pd.read_csv("../data/agriculture_crop_production.csv")

# 🧪 Step 3: Look at first few rows
print("First 5 rows:")
print(df.head())

# 🧪 Step 4: Summary of dataset
print("\nDataset Info:")
print(df.info())

print("\nSummary Statistics:")
print(df.describe())

# 🧪 Step 5: Check missing values
print("\nMissing Values per Column:")
print(df.isnull().sum())

# 🧪 Step 6: Graph - Crop quantity by state
plt.figure(figsize=(12,6))
sns.barplot(x="state", y="quantity", data=df)
plt.xticks(rotation=90)
plt.title("Crop Quantity by State")
plt.show()

# 🧪 Step 7: Correlation heatmap
plt.figure(figsize=(8,6))
sns.heatmap(df.corr(), annot=True, cmap="coolwarm")
plt.title("Correlation Matrix")
plt.show()
